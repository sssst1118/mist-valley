; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="雾谷仙农录"
config/description="Chronicles of Mist Valley — 2D 像素风修仙农场模拟"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
run/main_scene="res://world/Main.tscn"

[autoload]

; 组合根（ARCHITECTURE ADR-007）：全游戏只在这里 new 出具体实现
GameRoot="*res://world/GameRoot.tscn"

[dotnet]

project/assembly_name="XingGame"

[rendering]

; 2D 像素风：最近邻采样，避免缩放糊边（技术栈「2D 像素风」）
textures/canvas_textures/default_texture_filter=0

[input]

; 玩家移动与交互（M1-3）。用 physical_keycode 而非 keycode：AZERTY 键盘上 WASD 的
; 物理位置不变，改的是字符。方向键与 E 键同理。

