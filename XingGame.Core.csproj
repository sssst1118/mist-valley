<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>XingGame</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    纯 C# 区（ARCHITECTURE.md ADR-002）。

    本工程【不引用 GodotSharp】—— 这是刻意的：core/ 与 systems/ 里只要出现
    一个 `using Godot;`，这里就编译不过。边界由编译器强制，而不是靠人自觉。

    桥接层目录（world/ entities/ ui/ mods/）与 tests/ 在此排除，
    它们归 XingGame.csproj 或 tests/XingGame.Tests.csproj。
  -->
  <ItemGroup>
    <Compile Remove="world/**" />
    <Compile Remove="entities/**" />
    <Compile Remove="ui/**" />
    <Compile Remove="mods/**" />
    <Compile Remove="tests/**" />
    <Compile Remove=".godot/**" />
  </ItemGroup>

  <!--
    唯一的第三方依赖。设计文档 §21.1 定的存储方案就是 SQLite，这里选微软官方的
    ADO.NET provider（而非 System.Data.SQLite）——它随包带上 SQLitePCLRaw 的原生库，
    跨平台且与 .NET 8 同步发版。见 ARCHITECTURE.md ADR-008。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
  </ItemGroup>

</Project>
